# O arquivo .env.example contém apenas exemplos. Nunca coloque credenciais reais nele.
# O arquivo .env local é ignorado pelo Git.

# Ambiente e URL pública
# NODE_ENV é definido pelo Next.js/host; não force production durante o desenvolvimento.
NODE_ENV="development"
APP_URL="http://localhost:3000"
# Lista separada por vírgulas. Em produção, inclua somente os domínios HTTPS oficiais.
ALLOWED_ORIGINS="http://localhost:3000"
# true somente quando o proxy reverso sobrescreve x-forwarded-for/x-real-ip.
TRUST_PROXY="false"
# Em produção, use true. O código também força cookies Secure quando NODE_ENV=production.
COOKIE_SECURE="false"
SESSION_TTL_DAYS="30"

# Observabilidade (opcional localmente; recomendado em produção)
# O DSN do Sentry não é uma senha, mas deve ser configurado por ambiente.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
# Apenas no CI/servidor de build. Nunca exponha este token ao navegador.
# SENTRY_AUTH_TOKEN="token-de-deploy-do-sentry"
# SENTRY_ORG="slug-da-organizacao"
# SENTRY_PROJECT="slug-do-projeto"
# SENTRY_RELEASE="versao-ou-sha-do-deploy"

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/site_casamento?schema=public"
DATABASE_POOL_MAX="10"
DATABASE_CONNECTION_TIMEOUT_MS="10000"

# Armazenamento local apenas para desenvolvimento
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH=".local-storage"
MAX_UPLOAD_BYTES="15728640"

# Conta demo local. Use uma senha própria no .env; nunca reutilize em produção.
DEMO_ADMIN_EMAIL="cerimonial@demo.test"
DEMO_ADMIN_PASSWORD="defina-uma-senha-local-com-no-minimo-6-caracteres"
DEMO_ADMIN_NAME="Cerimonialista Demo"

# Acesso interno do proprietário da plataforma.
# Use senha exclusiva e execute `npm run platform:admin` após preencher estas variáveis.
PLATFORM_ADMIN_EMAIL="owner@example.com"
PLATFORM_ADMIN_PASSWORD="defina-uma-senha-exclusiva-com-no-minimo-6-caracteres"
PLATFORM_ADMIN_NAME="Dono do SiteCasamento"

# Produção: use o secret manager do host, valores HTTPS e armazenamento privado.
# Antes de publicar, execute `npm run deploy:check` com estas variáveis carregadas.
# NODE_ENV="production"
# APP_URL="https://casamento.example.com"
# ALLOWED_ORIGINS="https://casamento.example.com"
# TRUST_PROXY="true"
# COOKIE_SECURE="true"
# DATABASE_URL="postgresql://usuario:senha@host-gerenciado:5432/site_casamento?sslmode=require&schema=public"
# DATABASE_POOL_MAX="2"
# DATABASE_CONNECTION_TIMEOUT_MS="10000"
# STORAGE_DRIVER="s3-compatible"
# MAX_UPLOAD_BYTES="15728640"
# O bucket deve permanecer privado, sem URL pública ou r2.dev.
# S3_BUCKET="nome-do-bucket-privado"
# S3_REGION="auto"
# S3_ENDPOINT="https://endpoint-do-provedor"
# S3_ACCESS_KEY_ID="chave-fornecida-pelo-provedor"
# S3_SECRET_ACCESS_KEY="segredo-fornecido-pelo-provedor"
# S3_FORCE_PATH_STYLE="false"
