# PostgreSQL local ou hospedado. Nunca versione o arquivo .env real.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/site_casamento?schema=public"

# Em desenvolvimento as imagens são gravadas fora do código, neste diretório.
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH=".local-storage"
MAX_UPLOAD_BYTES="15728640"

# Acesso interno do dono da plataforma. Use uma senha exclusiva, com no mínimo 12 caracteres,
# e execute `npm run platform:admin` após preencher essas variáveis no .env.
PLATFORM_ADMIN_EMAIL="owner@example.com"
PLATFORM_ADMIN_PASSWORD="troque-esta-senha-segura"
PLATFORM_ADMIN_NAME="Dono do SiteCasamento"

# Produção (S3, Cloudflare R2 ou MinIO): altere STORAGE_DRIVER e preencha.
# STORAGE_DRIVER="s3-compatible"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://SEU-ENDPOINT-S3"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
