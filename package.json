{
  "name": "jogo-de-fotos-casamento",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:check": "tsx prisma/check-connection.ts",
    "deploy:check": "tsx scripts/check-production-env.ts",
    "platform:admin": "tsx prisma/create-platform-admin.ts",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "test": "tsx --test tests/game-rules.test.ts",
    "test:production-smoke": "tsx scripts/production-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "^10.73.0",
    "dotenv": "17.4.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
